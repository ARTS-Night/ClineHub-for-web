{
  "name": "clinehub-for-web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm run build:client && node scripts/dev.mjs",
    "start": "tsx src/server.ts",
    "build:css": "sass client/styles/main.scss dist/styles.css --no-source-map --style=compressed",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "tsup",
    "build:pack": "pnpm run build:client && pnpm run build:server",
    "build": "pnpm run build:client && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "sessions:clear": "tsx scripts/clear-sessions.ts",
    "test": "pnpm run build:client && node --check dist/app.js && tsc --noEmit && node scripts/run-tests.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@cline/sdk": "^0.0.75",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai-sdk-provider-claude-code": "^4.1.1",
    "dompurify": "^3.4.13",
    "hono": "^4.13.2",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.5",
    "sass": "^1.102.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
