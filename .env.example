# Optional login gate. Set both to require a username/password before the
# app can be used at all; leave either unset (the default) to keep the app
# open with no login, same as before this feature existed. Easier than
# editing this by hand: `clinehub-for-web --add-user <user> <password>` /
# `--remove-user` write/clear these two lines for you.
CLINEHUB_USER=
CLINEHUB_PASSWORD=

# Bind address/port. Overridden by --ip=/--port= on the command line if given.
# PORT=3000
# HOST=127.0.0.1
